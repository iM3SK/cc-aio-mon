#!/usr/bin/env bash
# pre-push hook — scans outgoing commits for obvious secrets and sensitive files.
# Blocks push if matches found. Override only with --no-verify (discouraged).
# Activate per-clone with:  git config core.hooksPath .githooks

set -u

remote="${1-}"
fail=0
seen=" "

die() {
    echo "BLOCKED: unable to inspect outgoing history; push aborted." >&2
    exit 1
}

matches() {
    printf '%s\n' "$diff_text" | grep -E -- "$1" >/dev/null
    local statuses=("${PIPESTATUS[@]}")
    [ "${statuses[0]}" -eq 0 ] || die
    [ "${statuses[1]}" -le 1 ] || die
    return "${statuses[1]}"
}

# Git supplies exact old/new object IDs for each ref. Deleted refs need no scan.
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" =~ ^0+$ ]] && continue
    [[ "$local_sha" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || die
    [[ "$remote_sha" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || die
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        # No tracking refs for this remote means no exclusions: inspect all
        # reachable history. Never use local branches or a different remote.
        commits=$(git rev-list "$local_sha" --not "--remotes=$remote" 2>/dev/null) || die
    else
        commits=$(git rev-list "$local_sha" "^$remote_sha" 2>/dev/null) || die
    fi
    for commit in $commits; do
        case "$seen" in *" $commit "*) continue ;; esac
        seen="$seen$commit "
        # -m compares merges against every parent, --root covers initial commits.
        # Disabling rename detection also exposes the full destination content.
        # NUL-delimited filenames never pass through command substitution.
        git diff-tree --root -m --no-commit-id --no-renames -r --name-only -z \
            --diff-filter=ACMRT --no-ext-diff --no-textconv "$commit" -- 2>/dev/null |
        (
            found=0
            while IFS= read -r -d '' f; do
                case "$f" in
                    *.pem|*.key|*.crt|*.p12|credentials.json|.env|.env.*|.envrc|secrets/*|*.log)
                        # Do not echo paths: they may contain terminal controls
                        # or credential-equivalent content.
                        echo "BLOCKED: sensitive filename in outgoing commit $commit" >&2
                        found=1
                        ;;
                esac
            done
            exit "$found"
        )
        statuses=("${PIPESTATUS[@]}")
        [ "${statuses[0]}" -eq 0 ] || die
        [ "${statuses[1]}" -le 1 ] || die
        [ "${statuses[1]}" -eq 0 ] || fail=1

        diff_text=$(git diff-tree --root -m --no-commit-id --no-renames -r -p \
            --no-color --no-ext-diff --no-textconv --diff-filter=ACMRT "$commit" -- \
            '*.py' '*.sh' '*.ps1' '*.md' '*.yml' '*.yaml' '*.json' 2>/dev/null) || die
        # Block obvious credential patterns in diff content (heuristic, not exhaustive)
        if matches 'sk-ant-[a-zA-Z0-9_-]{20,}'; then
            echo "BLOCKED: Anthropic API key pattern (sk-ant-*) in diff" >&2
            fail=1
        fi
        if matches 'sk-proj-[a-zA-Z0-9_-]{20,}'; then
            echo "BLOCKED: OpenAI API key pattern (sk-proj-*) in diff" >&2
            fail=1
        fi
        if matches '(AKIA|ASIA)[0-9A-Z]{16}'; then
            echo "BLOCKED: AWS Access Key ID pattern (AKIA/ASIA) in diff" >&2
            fail=1
        fi
        if matches 'ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{40,}|gh[suor]_[a-zA-Z0-9]{36,}'; then
            echo "BLOCKED: GitHub token pattern (ghp/ghs/ghu/gho/ghr/github_pat) in diff" >&2
            fail=1
        fi
        if matches 'AIza[0-9A-Za-z_-]{35}'; then
            echo "BLOCKED: Google API key pattern (AIza...) in diff" >&2
            fail=1
        fi
        if matches 'xox[baprs]-[0-9]{10,}-[0-9]{10,}-[a-zA-Z0-9]{20,}'; then
            echo "BLOCKED: Slack token pattern (xox[baprs]-...) in diff" >&2
            fail=1
        fi
        if matches '(sk|rk|pk)_(live|test)_[a-zA-Z0-9]{20,}'; then
            echo "BLOCKED: Stripe key pattern (sk_live/sk_test/rk_live/pk_live) in diff" >&2
            fail=1
        fi
        if matches '-----BEGIN ((RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY|PRIVATE KEY|ENCRYPTED PRIVATE KEY)-----'; then
            echo "BLOCKED: Private key block in diff" >&2
            fail=1
        fi
    done
done

if [ "$fail" -ne 0 ]; then
    echo "Push aborted by .githooks/pre-push — review findings above." >&2
    exit 1
fi

exit 0
